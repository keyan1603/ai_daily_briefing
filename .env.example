# ============================================================
# AI PROVIDER — switch between Anthropic and Google Gemini
# ============================================================
# Set to "gemini" or "anthropic" (default: anthropic)
AI_PROVIDER=anthropic

# --- Google Gemini (free tier) ---
# Get key: https://aistudio.google.com/app/apikey
# Free: 15 req/min, 1500 req/day with gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Timeouts ---
# Increase these if your AI provider is slow or you are using higher-latency models.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
NEWS_TIMEOUT_MS=30000
RECOMMEND_TIMEOUT_MS=45000

# --- Anthropic Claude (optional, $5 free credit) ---
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- NewsData.io (optional, 200 req/day free) ---
# https://newsdata.io/register
NEWSDATA_API_KEY=your_newsdata_api_key_here

# --- Calendarific holidays (optional, 1000 req/month free) ---
# https://calendarific.com/sign-up
CALENDARIFIC_API_KEY=your_calendarific_api_key_here

# --- App URL (update after Vercel deploy) ---
APP_URL=http://localhost:3000
